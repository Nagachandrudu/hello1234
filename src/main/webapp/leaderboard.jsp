<%@ page import="java.sql.*,com.codequest.util.DBConnection" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Leaderboard | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⌘ CodeQuest</a><div class="navlinks"><a href="register.jsp">Register</a><a href="login.jsp">Login</a><a href="missions">Missions</a><a href="dashboard">Dashboard</a></div></nav><main class="page"><h1>Global leaderboard</h1><p class="muted">Ranked by total XP. Refresh the page to see the latest scores.</p><div class="table-wrap"><table><thead><tr><th>Rank</th><th>Username</th><th>Level</th><th>Completed missions</th><th>Total XP</th></tr></thead><tbody>
<% boolean any=false; int rank=0; String sql="SELECT u.username,u.level,u.xp,COUNT(CASE WHEN s.is_correct=TRUE THEN 1 END) completed FROM users u LEFT JOIN mission_submissions s ON s.user_id=u.id GROUP BY u.id,u.username,u.level,u.xp ORDER BY u.xp DESC,u.username ASC";
try(Connection c=DBConnection.getConnection();PreparedStatement p=c.prepareStatement(sql);ResultSet r=p.executeQuery()){while(r.next()){any=true;rank++;String medal=rank==1?"🥇":rank==2?"🥈":rank==3?"🥉":String.valueOf(rank);%><tr><td class="rank"><%=medal%></td><td><%=r.getString("username")%></td><td><%=r.getInt("level")%></td><td><%=r.getInt("completed")%></td><td><strong><%=r.getInt("xp")%></strong></td></tr><% }}catch(SQLException e){%><tr><td colspan="5">Leaderboard could not load. Check database configuration.</td></tr><% } if(!any){%><tr><td colspan="5">No players yet. Register to claim the first spot!</td></tr><% } %>
</tbody></table></div></main></body></html>
