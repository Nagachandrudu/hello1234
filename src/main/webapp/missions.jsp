<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%
if(session.getAttribute("studentId")==null){response.sendRedirect(request.getContextPath()+"/login.jsp");return;}
java.util.List missions=(java.util.List)request.getAttribute("missions");
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Missions | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⌘ CodeQuest</a><div class="navlinks"><a href="dashboard">Dashboard</a><a href="leaderboard.jsp">Leaderboard</a><a href="logout">Logout</a></div></nav><main class="page"><h1>Programming missions</h1><p class="muted">One attempt per mission. Correct answers award XP.</p><div class="grid">
<% if(missions==null||missions.isEmpty()){ %><div class="card">No missions available yet. Please check again later.</div><% } else {for(Object item:missions){java.util.Map m=(java.util.Map)item;boolean attempted=((Integer)m.get("attempted"))==1;%><article class="card"><span class="pill"><%=m.get("category")%></span><span class="pill"><%=m.get("difficulty")%></span><h2><%=m.get("title")%></h2><p class="muted"><%=m.get("description")%></p>
<% if(attempted){ %><div class="<%=Boolean.TRUE.equals(m.get("correct"))?"success":"error"%>"><%=Boolean.TRUE.equals(m.get("correct"))?"Completed successfully":"Attempt used"%></div><% } else { %>
<form action="submit-answer" method="post"><input type="hidden" name="missionId" value="<%=m.get("id")%>">
<label class="choice"><input type="radio" name="answer" value="A" required><strong>A.</strong> <%=m.get("a")%></label><label class="choice"><input type="radio" name="answer" value="B"><strong>B.</strong> <%=m.get("b")%></label><label class="choice"><input type="radio" name="answer" value="C"><strong>C.</strong> <%=m.get("c")%></label><label class="choice"><input type="radio" name="answer" value="D"><strong>D.</strong> <%=m.get("d")%></label><button type="submit">Submit answer</button></form><% } %></article><% }} %>
</div></main></body></html>
