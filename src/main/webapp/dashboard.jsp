%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Dashboard | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⌘ CodeQuest</a><div class="navlinks"><a href="missions">Missions</a><a href="leaderboard.jsp">Leaderboard</a><a href="logout">Logout</a></div></nav><main class="page"><h1>Welcome back, <%=username%> 👋</h1><p class="muted">Every mission is a chance to improve your skills.</p><div class="grid"><div class="card"><span class="muted">TOTAL XP</span><h2><%=xp%> XP</h2></div><div class="card"><span class="muted">CURRENT LEVEL</span><h2>Level <%=level%></h2></div><div class="card"><span class="muted">MISSIONS COMPLETED</span><h2><%=completed%></h2></div></div><div class="card" style="margin-top:18px"><h2>Progress to next level</h2><p class="muted"><%=progress%> / 100 XP in this level</p><div class="bar"><span style="width:<%=progress%>%"></span></div><p class="muted">Earn <%=100-progress%> more XP to reach Level <%=level+1%>.</p></div><div class="actions" style="justify-content:flex-start"><a class="btn primary" href="missions">Continue missions →</a><a class="btn secondary" href="leaderboard.jsp">View leaderboard</a></div></main></body></html>
