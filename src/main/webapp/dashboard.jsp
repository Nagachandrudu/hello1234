String username=(String)request.getAttribute("username");Integer xp=(Integer)request.getAttribute("xp");Integer level=(Integer)request.getAttribute("level");Integer completed=(Integer)request.getAttribute("completed");Integer progress=(Integer)request.getAttribute("progress");
