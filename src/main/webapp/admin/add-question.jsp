<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%
if(session.getAttribute("adminId")==null){response.sendRedirect(request.getContextPath()+"/admin-login.jsp");return;}
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Add Question | CodeQuest</title><link rel="stylesheet" href="../css/style.css"></head><body><nav class="nav"><a class="brand" href="../index.html">⌘ CodeQuest Admin</a><div class="navlinks"><a href="dashboard.jsp">Dashboard</a><a href="../admin/questions">Question bank</a></div></nav><main class="page"><section class="form-card"><h1>Create mission</h1><% if(request.getAttribute("error")!=null){ %><div class="error"><%= request.getAttribute("error") %></div><% } %>
<form action="../admin/add-question" method="post">
<div class="field"><label>Question title</label><input name="title" required maxlength="120"></div>
<div class="field"><label>Description / question</label><textarea name="description" required></textarea></div>
<div class="two-col"><div class="field"><label>Category</label><select name="category" required><option value="Java">Java</option><option value="SQL">SQL</option><option value="DSA">DSA</option></select></div><div class="field"><label>Difficulty</label><select name="difficulty" required><option>Easy</option><option>Medium</option><option>Hard</option></select></div></div>
<div class="field"><label>Choice A</label><input name="optionA" required maxlength="255"></div><div class="field"><label>Choice B</label><input name="optionB" required maxlength="255"></div><div class="field"><label>Choice C</label><input name="optionC" required maxlength="255"></div><div class="field"><label>Choice D</label><input name="optionD" required maxlength="255"></div>
<div class="two-col"><div class="field"><label>Correct answer</label><select name="correctAnswer" required><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select></div><div class="field"><label>XP reward (0–10000)</label><input type="number" name="xpReward" min="0" max="10000" value="10" required></div></div><button type="submit">Save mission</button></form></section></main></body></html>
