<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%
if(session.getAttribute("studentId")==null){response.sendRedirect(request.getContextPath()+"/login.jsp");return;}
Boolean correct=(Boolean)request.getAttribute("correct");String message=(String)request.getAttribute("resultMessage");if(message==null)message="No result was supplied. Return to missions and try again.";
%><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><title>Mission Result | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⌘ CodeQuest</a><div class="navlinks"><a href="dashboard">Dashboard</a><a href="missions">Missions</a></div></nav><main class="page"><section class="card result"><div class="result-icon"><%=Boolean.TRUE.equals(correct)?"🏆":"🧩"%></div><h1><%=Boolean.TRUE.equals(correct)?"Mission complete!":"Mission result"%></h1><p><%=message%></p><% if(Boolean.TRUE.equals(correct)){Object earned=request.getAttribute("xpAwarded");%><p class="accent"><strong>+<%=earned==null?0:earned%> XP</strong></p><% } %><div class="actions"><a class="btn primary" href="missions">Back to missions</a><a class="btn secondary" href="dashboard">View progress</a></div></section></main></body></html>
